# Copiá este archivo a .env. Los valores sirven tal cual para desarrollo;
# los marcados con [PROD] hay que cambiarlos para producción.

# --- Postgres ---
POSTGRES_DB=analytics
POSTGRES_USER=analytics
# [PROD] contraseña fuerte (y la misma dentro de DATABASE_URL)
POSTGRES_PASSWORD=analytics
DATABASE_URL=postgres://analytics:analytics@db:5432/analytics

# --- Django ---
# [PROD] clave larga y aleatoria: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
# En desarrollo docker-compose.yml fuerza DEBUG=1; docker-compose.prod.yml fuerza 0.
DJANGO_DEBUG=1
# [PROD] el dominio público del backend, ej: analytics.midominio.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# [PROD] https://analytics.midominio.com
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost
# [PROD] 1 si hay un proxy con TLS delante (cookies seguras y X-Forwarded-Proto)
DJANGO_BEHIND_HTTPS_PROXY=0

# --- Ingesta ---
# Orígenes fijos extra para CORS (los dominios de cada sitio se permiten solos)
CORS_ALLOWED_ORIGINS=
# 0 = acepta requests sin header Origin (útil para probar con curl)
TRACKING_REQUIRE_ORIGIN=1
# 1 = confiar en X-Forwarded-For y CF-IPCountry (sólo detrás de un proxy propio)
TRACKING_TRUST_PROXY_HEADERS=0
# Ruta dentro del contenedor a GeoLite2-Country.mmdb (vacío = sin país)
GEOIP_PATH=

# --- Marca del dashboard (opcional) ---
# Nombre, color de acento (#RRGGBB), logo (URL de una imagen que se vea bien sobre fondo oscuro)
# y tema inicial: system, light o dark. Sin valores se usa el estilo neutro.
BRAND_NAME=
BRAND_COLOR=
BRAND_LOGO_URL=
BRAND_DEFAULT_THEME=system



# (producción: ver .env.production.example)
