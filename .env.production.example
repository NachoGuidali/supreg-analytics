# Producción (docker-compose.prod.yml). Copiá este archivo como .env en el servidor.

# --- Dominio ---
DOMAIN=analytics.supregsolutions.com

# --- Puertos (el servidor tiene otros servicios: ver DEPLOY.md) ---
# El dashboard escucha sólo en 127.0.0.1:WEB_PORT; el proxy del servidor le pasa el tráfico.
WEB_PORT=8090
# Si los puertos 80/443 están LIBRES y querés que el proyecto saque el HTTPS solo, descomentá:
# COMPOSE_PROFILES=caddy
# Si tu proxy corre en Docker (Nginx Proxy Manager, Traefik…): nombre de su red (docker network ls).
PROXY_NETWORK=

# --- Postgres ---
POSTGRES_DB=analytics
POSTGRES_USER=analytics
# Contraseña fuerte; la misma va dentro de DATABASE_URL.
POSTGRES_PASSWORD=CAMBIAR
DATABASE_URL=postgres://analytics:CAMBIAR@db:5432/analytics

# --- Django ---
# python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=CAMBIAR
DJANGO_ALLOWED_HOSTS=analytics.supregsolutions.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://analytics.supregsolutions.com
GUNICORN_WORKERS=3

# --- Ingesta ---
CORS_ALLOWED_ORIGINS=
TRACKING_REQUIRE_ORIGIN=1
# País de los visitantes: dejá GeoLite2-Country.mmdb en deploy/geoip/ (ver DEPLOY.md).
GEOIP_PATH=/geoip/GeoLite2-Country.mmdb

# --- Marca ---
BRAND_NAME=SupReg Analytics
BRAND_COLOR=
BRAND_LOGO_URL=
BRAND_DEFAULT_THEME=system

# --- Venta (botón "Contratar" del login) ---
# Hoy deriva a WhatsApp. Cuando tengas un link de pago (Mercado Pago), ponelo en SALES_URL y tiene prioridad.
SALES_WHATSAPP=5491178220245
SALES_MESSAGE=Hola, quiero contratar SupReg Analytics
SALES_URL=
PRODUCT_URL=https://supregsolutions.com/analytics

# --- Suscripciones ---
# Días antes del vencimiento en que se avisa (a vos y a los dueños del cliente).
BILLING_WARN_DAYS=7
# 1 = bloquear a los clientes vencidos hace más de BILLING_GRACE_DAYS días (no entran y sus webs
# dejan de registrar visitas; al registrar el pago se desbloquean). 0 = sólo avisar.
BILLING_AUTO_BLOCK=0
BILLING_GRACE_DAYS=5

# --- Backups ---
BACKUP_KEEP_DAYS=14
